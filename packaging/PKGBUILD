# Maintainer: hollali <dheztinykartel@gmail.com>
pkgname=organize
pkgver=1.3.1
pkgrel=1
pkgdesc="Sort files and folders into category folders with undoable moves"
arch=('any')
url="https://github.com/hollali/file-organizer"
license=('MIT')
depends=('bash' 'coreutils' 'findutils')
optdepends=('perl-image-exiftool: EXIF dates for images')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/organize-v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
	cd "$pkgname"
	make install DESTDIR="$pkgdir" PREFIX=/usr
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
